const CLOUD_FILE='sk-web-central.json';
function doGet(){return json_({ok:true,service:'SK Web Sync',time:new Date().toISOString()})}
function doPost(e){try{const q=JSON.parse(e.postData.contents||'{}'),expected=PropertiesService.getScriptProperties().getProperty('SK_SYNC_KEY');if(!expected||q.key!==expected)throw new Error('Acceso no autorizado');if(q.action!=='sync'||!q.data)throw new Error('Solicitud no válida');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const id=findFile_(),cloud=id?readFile_(id):{},merged=merge_(cloud,q.data);writeFile_(id,merged);return json_({ok:true,data:merged})}finally{lock.releaseLock()}}catch(e){return json_({ok:false,error:String(e&&e.message||e)})}}
function merge_(cloud,local){const out={schema:6,updatedAt:new Date().toISOString()},names=new Set(Object.keys(cloud||{}).concat(Object.keys(local||{})));names.delete('schema');names.delete('updatedAt');names.forEach(name=>{const map=new Map(),remote=Array.isArray(cloud[name])?cloud[name]:[],device=Array.isArray(local[name])?local[name]:[];remote.forEach(x=>{if(x&&x.id)map.set(x.id,x)});device.forEach(x=>{if(x&&x.id)map.set(x.id,choose_(x,map.get(x.id)))});out[name]=Array.from(map.values())});return out}
function choose_(local,remote){if(!remote)return local;if(!local)return remote;const ls=local.syncState==='seed',rs=remote.syncState==='seed';if(ls!==rs)return ls?remote:local;return stamp_(local)>=stamp_(remote)?local:remote}
function stamp_(x){const n=Date.parse(x.updatedAt||x.createdAt||'');return isNaN(n)?0:n}
function api_(url,options){const r=UrlFetchApp.fetch(url,Object.assign({muteHttpExceptions:true,headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()}},options||{})),code=r.getResponseCode();if(code<200||code>=300)throw new Error('Google Drive respondió '+code+': '+r.getContentText());return r}
function findFile_(){const q=encodeURIComponent("name='"+CLOUD_FILE+"' and trashed=false"),files=JSON.parse(api_('https://www.googleapis.com/drive/v3/files?spaces=appDataFolder&q='+q+'&fields=files(id)&pageSize=1').getContentText()).files||[];return files.length?files[0].id:''}
function readFile_(id){return JSON.parse(api_('https://www.googleapis.com/drive/v3/files/'+id+'?alt=media').getContentText())}
function writeFile_(id,data){const body=JSON.stringify(data);if(id){api_('https://www.googleapis.com/upload/drive/v3/files/'+id+'?uploadType=media',{method:'patch',contentType:'application/json',payload:body});return id}const boundary='skweb'+Date.now(),multipart='--'+boundary+'\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n'+JSON.stringify({name:CLOUD_FILE,parents:['appDataFolder'],mimeType:'application/json'})+'\r\n--'+boundary+'\r\nContent-Type: application/json\r\n\r\n'+body+'\r\n--'+boundary+'--',r=api_('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id',{method:'post',contentType:'multipart/related; boundary='+boundary,payload:multipart});return JSON.parse(r.getContentText()).id}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
