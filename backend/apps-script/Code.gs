      }).filter(Boolean);
    });
    allowed.inventoryStock=Array.from(stock.values());
    const merged=merge_(cloud,allowed);writeFile_(id,merged);const view={schema:merged.schema,updatedAt:merged.updatedAt};
    PLAZA_READ.forEach(name=>view[name]=Array.isArray(merged[name])?merged[name]:[]);view.personal=view.personal.map(x=>publicPerson_(x));
    return json_({ok:true,data:view});
  }finally{lock.releaseLock()}
}
function stampActor_(x,auth){if(!x||!x.id)throw new Error('Movimiento sin identificador');const out=Object.assign({},x);out.actorDocument=auth.document;out.actorRole=auth.role;delete out.pinHash;delete out.plazaEnabled;delete out.plazaRole;return out}
function truthy_(value){return value===true||['true','si','sí','1','yes'].indexOf(String(value||'').trim().toLowerCase())>=0}
function hashPin_(document,pin){const salt=PropertiesService.getScriptProperties().getProperty('SK_AUTH_SALT');if(!salt)throw new Error('Falta configurar SK_AUTH_SALT');return hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,document+'|'+pin+'|'+salt,Utilities.Charset.UTF_8))}
function sign_(payload){const secret=PropertiesService.getScriptProperties().getProperty('SK_AUTH_SECRET');if(!secret)throw new Error('Falta configurar SK_AUTH_SECRET');return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(payload,secret))}
function verifyToken_(token){const bits=String(token||'').split('.');if(bits.length!==2)throw new Error('Sesión no válida');const payload=Utilities.newBlob(Utilities.base64DecodeWebSafe(bits[0])).getDataAsString(),parts=payload.split('|');if(parts.length!==3||!safeEqual_(bits[1],sign_(payload))||Number(parts[2])<Date.now())throw new Error('La sesión venció');if(parts[1]!=='plaza_operator'&&parts[1]!=='plaza_supervisor')throw new Error('Permiso no válido');return{document:parts[0],role:parts[1]}}
function safeEqual_(a,b){a=String(a);b=String(b);if(a.length!==b.length)return false;let n=0;for(let i=0;i<a.length;i++)n|=a.charCodeAt(i)^b.charCodeAt(i);return n===0}
function hex_(bytes){return bytes.map(x=>(x<0?x+256:x).toString(16).padStart(2,'0')).join('')}
function enablePlazaUser(document,pin,role){document=String(document||'').trim();pin=String(pin||'');if(!document||!pin)throw new Error('Documento y contraseña son obligatorios');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const id=findFile_(),cloud=id?readFile_(id):{},matches=(cloud.personal||[]).filter(x=>String(x.documento||'').trim()===document&&!x.deleted),person=matches[0];if(!person)throw new Error('El documento no existe en Personal');const now=new Date().toISOString(),pinHash=hashPin_(document,pin),plazaRole=role==='supervisor'?'supervisor':'operator';matches.forEach(x=>{x.plazaEnabled=true;x.plazaRole=plazaRole;x.pinHash=pinHash;x.updatedAt=now});cloud.personal=dedupePersonal_(cloud.personal||[]);writeFile_(id,cloud);return 'Usuario de Plaza Blending habilitado: '+document}finally{lock.releaseLock()}}
function plazaUserAdmin_(q){const document=String(q.document||'').trim(),enabled=q.enabled===true,pin=String(q.pin||''),role=q.role==='supervisor'?'supervisor':'operator';if(!document)throw new Error('Selecciona un colaborador');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const id=findFile_(),cloud=id?readFile_(id):{},matches=(cloud.personal||[]).filter(x=>String(x.documento||'').trim()===document&&!x.deleted),person=matches[0];if(!person)throw new Error('El colaborador no existe en la base central');const now=new Date().toISOString(),existingHash=matches.map(x=>x.pinHash).find(Boolean),pinHash=pin?hashPin_(document,pin):existingHash;if(enabled&&!pinHash)throw new Error('Escribe una contraseña para habilitar el acceso');matches.forEach(x=>{if(enabled){x.pinHash=pinHash;x.plazaEnabled=true;x.plazaRole=role}else{x.plazaEnabled=false;delete x.pinHash;delete x.plazaRole}x.updatedAt=now});cloud.personal=dedupePersonal_(cloud.personal||[]);const saved=(cloud.personal||[]).find(x=>String(x.documento||'').trim()===document&&!x.deleted)||person;writeFile_(id,cloud);return json_({ok:true,user:{id:saved.id,documento:document,nombre:saved.nombre||'',plazaEnabled:saved.plazaEnabled===true,plazaRole:saved.plazaRole||''}})}finally{lock.releaseLock()}}
function plazaCollaborator_(q){const auth=verifyToken_(q.token),input=q.collaborator||{},document=String(input.documento||'').trim(),primerNombre=String(input.primerNombre||'').trim(),segundoNombre=String(input.segundoNombre||'').trim(),primerApellido=String(input.primerApellido||'').trim(),segundoApellido=String(input.segundoApellido||'').trim(),nombre=[primerNombre,segundoNombre,primerApellido,segundoApellido].filter(Boolean).join(' '),empresa=String(input.empresa||'').trim(),area=String(input.area||'').trim(),cargo=String(input.cargo||'No informado').trim()||'No informado',telefono=String(input.telefono||'').trim();if(!document||!primerNombre||!primerApellido||!empresa||!area)throw new Error('Documento, primer nombre, primer apellido, empresa y área son obligatorios');const lock=LockService.getScriptLock();lock.waitLock(30000);try{const id=findFile_(),cloud=id?readFile_(id):{},rows=Array.isArray(cloud.personal)?cloud.personal:(cloud.personal=[]),existing=rows.find(x=>String(x.documento||'').trim()===document&&!x.deleted);if(existing&&!q.update)return json_({ok:true,exists:true,user:publicPerson_(existing)});const now=new Date().toISOString(),person=existing||{id:'PERSONAL-PLAZA-'+Utilities.getUuid(),createdAt:now};Object.assign(person,{documento:document,primerNombre:primerNombre,segundoNombre:segundoNombre,primerApellido:primerApellido,segundoApellido:segundoApellido,nombre:nombre,empresa:empresa,area:area,cargo:cargo,telefono:telefono,deleted:false,updatedAt:now,syncState:'synced',registeredBy:auth.document});if(!existing)rows.push(person);cloud.personal=dedupePersonal_(rows);writeFile_(id,cloud);return json_({ok:true,exists:false,user:publicPerson_(person)})}finally{lock.releaseLock()}}
function publicPerson_(x){return{id:x.id,documento:x.documento||'',primerNombre:x.primerNombre||'',segundoNombre:x.segundoNombre||'',primerApellido:x.primerApellido||'',segundoApellido:x.segundoApellido||'',nombre:x.nombre||'',empresa:x.empresa||'',area:x.area||'',cargo:x.cargo||'No informado',telefono:x.telefono||'',deleted:!!x.deleted}}
function merge_(cloud,local){const out={schema:6,updatedAt:new Date().toISOString()},names=new Set(Object.keys(cloud||{}).concat(Object.keys(local||{})));names.delete('schema');names.delete('updatedAt');names.forEach(name=>{const map=new Map(),remote=Array.isArray(cloud[name])?cloud[name]:[],device=Array.isArray(local[name])?local[name]:[];remote.forEach(x=>{if(x&&x.id)map.set(x.id,x)});device.forEach(x=>{if(!x||!x.id)return;const central=map.get(x.id),chosen=choose_(x,central);if(name==='personal'&&central){const merged=Object.assign({},central,chosen);for(const field of ['pinHash','plazaEnabled','plazaRole']){if(Object.prototype.hasOwnProperty.call(central,field))merged[field]=central[field];else delete merged[field]}map.set(x.id,merged)}else map.set(x.id,chosen)});out[name]=Array.from(map.values())});if(Array.isArray(out.personal)){out.personal=dedupePersonal_(out.personal);const centralByDocument=new Map();(Array.isArray(cloud.personal)?cloud.personal:[]).filter(x=>x&&!x.deleted&&String(x.documento||'').trim()).forEach(x=>{const key=String(x.documento).trim(),old=centralByDocument.get(key);centralByDocument.set(key,choose_(x,old))});out.personal.forEach(x=>{const central=centralByDocument.get(String(x.documento||'').trim());if(central&&central.plazaEnabled===true&&central.pinHash){x.plazaEnabled=true;x.pinHash=central.pinHash;x.plazaRole=central.plazaRole||'operator'}else{delete x.pinHash;delete x.plazaEnabled;delete x.plazaRole}})}return out}
function dedupePersonal_(rows){const map=new Map();rows.forEach(x=>{if(!x||!x.id)return;const document=String(x.documento||'').trim(),key=document?'doc:'+document:'id:'+x.id,old=map.get(key);if(!old){map.set(key,x);return}const chosen=choose_(x,old);map.set(key,Object.assign({},old,chosen,{id:old.id||chosen.id}))});return Array.from(map.values())}
function choose_(local,remote){if(!remote)return local;if(!local)return remote;const ls=local.syncState==='seed',rs=remote.syncState==='seed';if(ls!==rs)return ls?remote:local;return stamp_(local)>=stamp_(remote)?local:remote}
function stamp_(x){const n=Date.parse(x.updatedAt||x.createdAt||'');return isNaN(n)?0:n}
function findFile_(){const files=DriveApp.getFilesByName(CLOUD_FILE),valid=[];let found=false;while(files.hasNext()){found=true;const file=files.next();try{const text=file.getBlob().getDataAsString('UTF-8'),data=JSON.parse(text);if(data&&typeof data==='object'&&!Array.isArray(data))valid.push(file)}catch(error){console.error('Base central descartada por contenido inválido',file.getId(),String(error&&error.message||error))}}if(!valid.length){if(found)throw new Error('La base central está dañada. Se bloqueó la operación para proteger los datos.');return''}valid.sort((a,b)=>b.getLastUpdated().getTime()-a.getLastUpdated().getTime());return valid[0].getId()}
function readFile_(id){return JSON.parse(DriveApp.getFileById(id).getBlob().getDataAsString('UTF-8'))}
function writeFile_(id,data){const body=JSON.stringify(data);if(id){DriveApp.getFileById(id).setContent(body);return id}return DriveApp.createFile(CLOUD_FILE,body,MimeType.PLAIN_TEXT).getId()}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
