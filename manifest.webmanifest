{
  "name": "SK Admin",
  "short_name": "SK Admin",
  "description": "Inventario, activos y consumo de repuestos con operación offline.",
  "id": "/SK-Web/",
  "start_url": "/SK-Web/index.html?source=pwa",
  "scope": "/SK-Web/index.html",
  "display": "standalone",
  "background_color": "#102c40",
  "theme_color": "#102c40",
  "lang": "es-CO",
  "icons": [
    {
      "src": "icons/sk-admin-marca-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/sk-admin-marca-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://controlesmineras.github.io/SK-Web/manifest.webmanifest",
      "id": "/SK-Web/"
    }
  ],
  "prefer_related_applications": false
}
